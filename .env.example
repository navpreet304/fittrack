# FitTrack Pro environment template — copy to .env and fill in real values.

# --- Flask runtime ---
FLASK_ENV=development
JWT_SECRET_KEY=replace-me-with-a-long-random-secret

# --- Database (PostgreSQL via docker-compose) ---
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack123
POSTGRES_DB=fittrackdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15432
# Or override the whole URL directly:
# DATABASE_URL=postgresql://fittrack:fittrack123@localhost:5432/fittrackdb

# --- Nutritionix API ---
# Leave blank to use the offline fallback table.
NUTRITION_APP_ID=
NUTRITION_API_KEY=
NUTRITION_API_URL=https://trackapi.nutritionix.com/v2

# --- Email notifications (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Caching ---
CACHE_DIR=.cache/nutrition

# --- Demo seed credentials (used by seed.py) ---
FITTRACK_DEMO_COACH_PASSWORD=coach123
FITTRACK_DEMO_USER_PASSWORD=user123
